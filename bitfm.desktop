[Desktop Entry]
Name=BitFM
GenericName=File Manager
Comment=Fast, modern native Linux file manager with tabbed browsing and terminal drawer
Exec=bitfm %U
Icon=bitfm
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=bitfm
Categories=System;FileTools;FileManager;Qt;
MimeType=inode/directory;x-scheme-handler/file;x-directory/normal;
Keywords=folder;manager;explore;disk;filesystem;wayland;files;file;bitfm;

Actions=NewWindow;Root;

[Desktop Action NewWindow]
Name=New Window
Exec=bitfm %U

[Desktop Action Root]
Name=Open as Administrator (Root)
Exec=sh -c 'exec pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" SUDO_USER="$USER" bitfm "$@"' sh %U
